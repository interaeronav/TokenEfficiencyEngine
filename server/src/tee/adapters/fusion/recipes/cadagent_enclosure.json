{
  "topic": "cadagent_enclosure",
  "title": "Parametric ventilated enclosure",
  "intent": "Anchor and fully constrain a footprint; drive an extrusion, shell it, pattern vents, revise width/depth and prove the design recomputes.",
  "ops": [
    {
      "op": "create",
      "kind": "param",
      "props": {
        "value": "120 mm",
        "units": "mm"
      },
      "name": "A79E_width"
    },
    {
      "op": "create",
      "kind": "param",
      "props": {
        "value": "80 mm",
        "units": "mm"
      },
      "name": "A79E_height"
    },
    {
      "op": "create",
      "kind": "param",
      "props": {
        "value": "30 mm",
        "units": "mm"
      },
      "name": "A79E_depth"
    },
    {
      "op": "create",
      "kind": "sketch",
      "props": {
        "rects": [
          [
            0,
            0,
            120,
            80
          ]
        ],
        "constraints": [
          {
            "type": "coincident",
            "of": [
              "r0.bl",
              "origin"
            ]
          },
          {
            "type": "horizontal",
            "of": [
              "r0.bottom"
            ]
          },
          {
            "type": "horizontal",
            "of": [
              "r0.top"
            ]
          },
          {
            "type": "vertical",
            "of": [
              "r0.left"
            ]
          },
          {
            "type": "vertical",
            "of": [
              "r0.right"
            ]
          }
        ],
        "dims": [
          {
            "type": "distance",
            "of": [
              "r0.bl",
              "r0.br"
            ],
            "orientation": "horizontal",
            "expression": "A79E_width"
          },
          {
            "type": "distance",
            "of": [
              "r0.bl",
              "r0.tl"
            ],
            "orientation": "vertical",
            "expression": "A79E_height"
          }
        ]
      },
      "name": "Enclosure footprint",
      "as": "footprint"
    },
    {
      "op": "create",
      "kind": "extrude",
      "props": {
        "sketch": "@footprint",
        "distance": 30
      },
      "name": "Enclosure blank",
      "as": "blank"
    },
    {
      "op": "set",
      "id": "@blank.feature",
      "props": {
        "expression": "A79E_depth"
      }
    },
    {
      "op": "create",
      "kind": "shell",
      "props": {
        "body": "@blank",
        "remove_faces": [
          "+z"
        ],
        "inside": 3
      },
      "name": "Three millimetre enclosure",
      "as": "shell"
    },
    {
      "op": "create",
      "kind": "hole",
      "props": {
        "body": "@blank",
        "face": "-z",
        "at": [
          20,
          20
        ],
        "diameter": 6,
        "through": true
      },
      "name": "Vent seed",
      "as": "vent"
    },
    {
      "op": "create",
      "kind": "rectangular_pattern",
      "props": {
        "features": [
          "@vent.feature"
        ],
        "axis": "x",
        "count": 5,
        "spacing": 20,
        "axis2": "y",
        "count2": 3,
        "spacing2": 20
      },
      "name": "Fifteen base vents",
      "as": "vents"
    },
    {
      "op": "set",
      "id": "@footprint",
      "props": {
        "visible": false
      }
    }
  ],
  "expected": {
