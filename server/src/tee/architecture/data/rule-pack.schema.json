{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tee:architecture:rulepack:1",
  "title": "TEE architectural rule pack; schema validity is not legal coverage",
  "type": "object",
  "required": ["schema", "id", "version", "kind", "edition", "authority", "jurisdiction", "effective_from", "rules"],
  "properties": {
    "schema": {"const": "tee-architecture-rulepack/1"},
    "id": {"$ref": "#/$defs/id"},
    "version": {"type":"string","minLength":1,"maxLength":96},
    "sha256": {"$ref": "#/$defs/hash"},
    "kind": {"enum":["synthetic","regulatory"]},
    "edition": {"type":"string","minLength":1,"maxLength":160},
    "authority": {"type":"string","minLength":1,"maxLength":256},
    "jurisdiction": {
      "type":"object", "required":["country"], "additionalProperties":false,
      "properties": {
        "country":{"type":"string","pattern":"^[A-Z]{2}$"},
        "region":{"type":["string","null"],"minLength":1,"maxLength":160},
        "municipality":{"type":["string","null"],"minLength":1,"maxLength":160}
      }
    },
    "effective_from":{"type":"string","format":"date"},
    "effective_until":{"type":["string","null"],"format":"date"},
    "source":{"type":"object","description":"Primary-source metadata required for regulatory evaluation; see README."},
    "review":{"type":"object","description":"Supplied named, dated interpretation review; not authenticated by the evaluator."},
    "adoption":{"type":"object","description":"Supplied adoption instrument, URL and effective_on date."},
    "requires": {
      "type":"array","maxItems":32,"items":{
        "type":"object","required":["id","version","sha256"],
        "properties":{"id":{"$ref":"#/$defs/id"},"version":{"type":"string","minLength":1,"maxLength":96},"sha256":{"$ref":"#/$defs/hash"}}
      }
    },
    "rules":{"type":"array","minItems":1,"maxItems":256,"items":{"$ref":"#/$defs/rule"}}
  },
  "$defs": {
    "id":{"type":"string","pattern":"^[A-Za-z0-9_-]{1,96}$"},
    "hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "rule": {
      "type":"object","required":["id","clause","fact","op","value","unit"],
      "properties": {
        "id":{"$ref":"#/$defs/id"},
        "clause":{"type":"string","minLength":1,"maxLength":256},
        "fact":{"type":"string","pattern":"^(project\\.facts\\.[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+){0,5}|entities\\.(\\*|[A-Za-z0-9_-]+)\\.[A-Za-z0-9_-]+)$"},
        "entity_kind":{"$ref":"#/$defs/id"},
        "where":{"type":"object","maxProperties":8,"additionalProperties":{"type":["string","number","boolean"]}},
        "op":{"enum":["gt","gte","lt","lte","eq"]},
        "value":{"type":"number","minimum":-1000000000000000,"maximum":1000000000000000},
        "unit":{"enum":["mm","m","mm2","m2","degrees","count","ratio"]},
        "applicability":{"type":"array","maxItems":16,"items":{
          "type":"object","required":["fact","op","value"],
          "properties":{
            "fact":{"type":"string","pattern":"^project\\.facts\\.[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+){0,5}$"},
            "op":{"enum":["eq","in"]},
            "value":{"oneOf":[{"type":["string","number","boolean"]},{"type":"array","minItems":1,"maxItems":32,"items":{"type":["string","number","boolean"]}}]}
          }
        }},
        "overrides":{"type":"array","maxItems":32,"items":{
          "type":"object","required":["pack_id","rule_id"],
          "properties":{"pack_id":{"$ref":"#/$defs/id"},"rule_id":{"$ref":"#/$defs/id"}}
        }}
      }
    }
  }
}
