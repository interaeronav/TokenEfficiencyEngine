on_reasoning = None

    def complete(
        prompt: str,
        *,
        system: str | None = None,
        url: str = DEFAULT_URL,
        model: str = DEFAULT_MODEL,
        max_tokens: int = 500,
        temperature: float = 0.0,
        reasoning_effort: str | None = None,
        timeout: float = 120.0,
        deadline_at: float | None = None,
        response_format: dict | None = None,
        adapters: str | None = DEFAULT_ADAPTERS,
        thinking: bool = False,
        on_usage: Callable[[dict, int, float], None] | None = None,
        on_reasoning: Callable[[str], None] | None = None,
    ) -> str:
        """One chore completion: deterministic, budgeted, thinking per-profile.
    
        `on_usage(payload, bytes_sent, seconds)` is called after a successful
        reply so the caller can meter it (A45 P1). The client stays ignorant of
        money: it reports what the provider said and what went on the wire.
    
        `on_reasoning(text)` receives the model's deliberation when the backend
        returns any. It is deliberately a side channel: reasoning is recorded
        for audit and training, and NEVER returned to the client - that is what
        makes thinking free in the metric TEE is judged by."""
        messages: list[dict] = []
        if system:
            messages.append({"role": "system", "content": system})
        messages.append({"role": "user", "content": prompt})
        body: dict = {
            "model": model,
            "max_tokens": max_tokens,
            "temperature": temperature,
            "messages": messages,
            # Per-profile (W0). Servers that don't know the flag are covered
            # by the inline-<think> capture below.
            "chat_template_kwargs": {"enable_thinking": bool(thinking)},
        }
        # W1: the MITIGATION CONTROL. The server carries a global default
        # (--reasoning-effort medium here) and TEE never spoke to it, so every
        # chore got one setting whatever its task. Measured 2026-09-14: error is
        # NOT monotone in effort - on triage's enum control both 27B builds are
        # correct at low and default effort and WRONG at high, the 4-bit running
        # to `length` with 10,839 characters of reasoning and no answer. Effort is
        # therefore a dial with a crossover, not a quality slider.
        if reasoning_effort:
            body["reasoning_effort"] = str(reasoning_effort)
        if response_format:
            body["response_format"] = response_format
        if adapters:
            body["adapters"] = adapters
        encoded = json.dumps(body).encode()
        request = urllib.request.Request(
            f"{url}/chat/completions",
            data=encoded,
            headers={"Content-Type": "application/json", "Authorization": "Bearer local"},
        )
        started = time.monotonic()
        # The socket timeout bounds ONE operation; `deadline_at` bounds the whole
        # exchange, including a body that arrives in slices.
        if deadline_at is not None:
            timeout = max(0.001, min(timeout, deadline_at - started))
        try:
            with urllib.request.urlopen(request, timeout=timeout) as response:
                payload = json.loads(_read_bounded(response, deadline_at) or b"{}")
        except urllib.error.HTTPError as exc:
            detail = exc.read()[:200].decode(errors="replace")
            # The server answered, so the request was dispatched - a 400 on a
            # transport parameter is refused BEFORE inference and is classified as
            # such by the caller, which knows what it sent.
            raise TeeError(
                "llm_failed",
                f"The local model rejected the request ({exc.code}): {detail}",
                fix="Check the endpoint log; chores fall back to their deterministic paths.",
            ) from exc
        except Dispatched:
            raise
        except (urllib.error.URLError, OSError) as exc:
            # PRE-INFERENCE only when the connection never came up. A timeout, a
            # reset or a short read after the request went out may have generated
            # a complete answer we then lost.
            cause = getattr(exc, "reason", exc)
            # errno 61/111 connection refused, 2 no such file (a unix socket),
            # -2/-3/8 DNS failures: the connection never came up, so nothing was
            # generated. Everything else after a send is ambiguous.
            pre = isinstance(cause, ConnectionRefusedError | FileNotFoundError) or (
                isinstance(cause, OSError) and getattr(cause, "errno", None) in (61, 111, 2, -2, -3, 8)
            )
            if pre and not isinstance(cause, TimeoutError):
                raise TeeError(
                    "llm_unreachable", f"No local model at {url} ({exc}).", fix=_UNREACHABLE_FIX
                ) from exc
            # A LIVE endpoint reported as absent was the wrong answer: when the
            # socket fired because the deadline squeezed its timeout, the cause is
            # the deadline, and saying "no local model" sends the caller to start a
            # stack that is already running (found by audit, 2026-09-14).
            if deadline_at is not None and time.monotonic() >= deadline_at - 0.002:
                raise Dispatched(
                    "llm_deadline",
                    f"the deadline was reached during the request to {url} "
                    f"({time.monotonic() - started:.3f}s elapsed); whether the model "
                    f"generated an answer is unknown.",
                    fix="Raise chore_deadline_s, lower the generation allowance, or "
                    "accept the deterministic path.",
                ) from exc
            raise Dispatched(
                "llm_unreachable",
                f"The request to {url} was sent and then failed ({exc}); whether the "
                f"model generated an answer is unknown.",
                fix=_UNREACHABLE_FIX,
            ) from exc
        except json.JSONDecodeError as exc:
            raise Dispatched(
                "llm_bad_response",
                f"The local model's reply was not JSON ({exc}).",
                fix="Check the endpoint log.",
            ) from exc
        if on_usage is not None:
            # metering must never break the chore it is measuring
            with contextlib.suppress(Exception):
                on_usage(payload, len(encoded), time.monotonic() - started)
        try:
